require "./filesystem"

## generate.cr — `jane -g`: print a starter control file for this host

module Jane
  module Generate
    extend self

    # Mounted filesystems backed by a block device. Pseudo filesystems (proc,
    # tmpfs, overlay, ...) and read-only images (squashfs snaps) are left out.
    SKIP_TYPES = %w(squashfs iso9660 udf)

    def make_config
      puts config_text(disk_mounts)
    end

    def config_text(mounts : Array(Filesystem::MountEntry)) : String
      String.build do |io|
        io << <<-CONF
        ## Jane control file — generated by `jane -g`
        ## Check it with `jane -t -c <file>`; see docs/control-file.md

        set cycle 10
        set log syslog level info
        # set hq <ip of HQ server> port 36777
        # set mailserver localhost port 25
        # set alert ops@example.com
        # include /etc/jane/conf.d/*.conf

        check system #{hostname}
            if cpu usage > 80, 85, 90 % for 3 cycles then alert
            if cpu (wait) > 60% for 3 cycles then alert
            if loadavg (5min) per core > 1.5, 2 then alert
            if memory usage > 80, 85, 90, 95 % then alert
            if swap usage > 50% then alert
            group system


        CONF
        mounts.each do |m|
          io << "check filesystem #{fs_name(m.mount_point)} with path #{m.mount_point}\n"
          io << "    if space usage > 85, 90, 95 % then alert\n"
          io << "    if inode usage > 90% then alert\n" unless no_inodes?(m.fs_type)
          io << "    group filesystems\n\n"
        end
        io << <<-CONF
        check process sshd matching "/usr/sbin/sshd"
            group process

        CONF
      end
    end

    def disk_mounts : Array(Filesystem::MountEntry)
      seen = Set(String).new
      Filesystem.mounts.select do |m|
        m.device.starts_with?("/dev/") && !SKIP_TYPES.includes?(m.fs_type) &&
          !m.mount_point.starts_with?("/snap/") && seen.add?(m.mount_point)
      end
    rescue File::Error
      [] of Filesystem::MountEntry
    end

    # "/" → "root", "/boot/efi" → "boot-efi"
    def fs_name(mount_point : String) : String
      mount_point == "/" ? "root" : mount_point.strip('/').gsub(/[^A-Za-z0-9_.-]+/, "-")
    end

    # Filesystems without fixed inode tables report 0 inodes.
    private def no_inodes?(fs_type : String) : Bool
      %w(btrfs vfat exfat zfs).includes?(fs_type)
    end

    private def hostname : String
      name = System.hostname rescue "localhost"
      name.split('.').first.gsub(/[^A-Za-z0-9_.-]+/, "-")
    end
  end
end
